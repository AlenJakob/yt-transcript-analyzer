{
  "name": "yt-transcript-analyzer",
  "version": "0.1.0",
  "description": "Aplikacja webowa do pobierania, przeglądania i analizy transkrypcji wideo z serwisu YouTube z obsługą szablonów promptów AI.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/material-nextjs": "^9.3.0",
    "@types/ws": "^8.18.1",
    "next": "16.2.12",
    "node-edge-tts": "^1.2.10",
    "openai": "^6.49.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.21.3",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
